# QA Gate Environment Configuration Template
# Copy this file to .env or export variables directly into your shell.
# DO NOT commit real API keys or credentials to version control.

# LLM Provider selection: 'mock' (default for tests/offline) or 'anthropic' (live extraction)
FACTUAL_LLM_PROVIDER=anthropic

# Anthropic API Key (required when FACTUAL_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic Claude Model Identifier (e.g. claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
